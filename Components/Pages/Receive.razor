@page "/receive"
@inject SeedSessionService Seed
@inject IJSRuntime JS
@inject QubicBackendService Backend

<h4>Receive</h4>

@if (!Seed.HasSeed)
{
    <div class="alert alert-warning small">
        <i class="bi bi-exclamation-triangle me-1"></i>No wallet open. Enter a seed first.
    </div>
}
else
{
    <div class="text-center">
        <div class="card">
            <div class="card-body py-4">
                <!-- QR Code -->
                <div class="d-flex justify-content-center mb-3">
                    <div style="background:#fff;padding:12px;border-radius:8px;display:inline-block">
                        @((MarkupString)_qrSvg)
                    </div>
                </div>

                <!-- Identity / payment request -->
                <div class="mb-1 small text-muted">@(_isRequest ? "Payment request" : "Your Identity")</div>
                <div class="mono p-2 rounded mb-3"
                     style="font-size:0.7rem;background:var(--qb-bg-elevated);word-break:break-all;user-select:all">
                    @_qrText
                </div>

                <div class="text-start mb-3">
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">Amount</span>
                        <input type="number" min="1" class="form-control" placeholder="optional" @bind="_reqAmount" @bind:after="GenerateQr" />
                        <span class="input-group-text">QU</span>
                    </div>
                    <input class="form-control form-control-sm" maxlength="120" placeholder="Message (optional)" @bind="_reqMessage" @bind:after="GenerateQr" />
                    @if (!Backend.Profile.IsMainnet)
                    {
                        <div class="small text-muted mt-1">Marked for <code>@Backend.Profile.ChainId</code> (@Backend.Profile.Name).</div>
                    }
                </div>

                <button class="btn btn-primary w-100 mb-2" @onclick="CopyIdentity">
                    <i class="bi bi-clipboard me-1"></i> @(_copied ? "Copied!" : _isRequest ? "Copy Payment Link" : "Copy Identity")
                </button>

                <button class="btn btn-outline-secondary w-100" @onclick="ShareIdentity">
                    <i class="bi bi-share me-1"></i> Share
                </button>
            </div>
        </div>
    </div>
}

@code {
    string _qrSvg = "";
    string _qrText = "";
    bool _isRequest;
    long? _reqAmount;
    string? _reqMessage;
    bool _copied;

    protected override void OnInitialized()
    {
        GenerateQr();
    }

    void GenerateQr()
    {
        var identity = Seed.Identity?.ToString();
        if (identity == null) return;
        _isRequest = _reqAmount is > 0 || !string.IsNullOrWhiteSpace(_reqMessage) || !Backend.Profile.IsMainnet;
        _qrText = _isRequest
            ? new Qubic.Core.Payments.QubicPaymentRequest
            {
                Destination = identity,
                Amount = _reqAmount is > 0 ? _reqAmount : null,
                Message = string.IsNullOrWhiteSpace(_reqMessage) ? null : _reqMessage.Trim(),
                Network = Backend.Profile.IsMainnet ? null : "testnet",
            }.ToUri()
            : identity;

        using var qrGenerator = new QRCoder.QRCodeGenerator();
        var qrData = qrGenerator.CreateQrCode(_qrText, QRCoder.QRCodeGenerator.ECCLevel.M);

        // Build SVG manually from the QR data
        var modules = qrData.ModuleMatrix;
        var size = modules.Count;
        var cellSize = 4;
        var svgSize = size * cellSize;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {svgSize} {svgSize}\" width=\"200\" height=\"200\">");
        sb.Append($"<rect width=\"{svgSize}\" height=\"{svgSize}\" fill=\"#fff\"/>");

        for (int y = 0; y < size; y++)
        {
            for (int x = 0; x < size; x++)
            {
                if (modules[y][x])
                {
                    sb.Append($"<rect x=\"{x * cellSize}\" y=\"{y * cellSize}\" width=\"{cellSize}\" height=\"{cellSize}\" fill=\"#000\"/>");
                }
            }
        }

        sb.Append("</svg>");
        _qrSvg = sb.ToString();
    }

    async Task CopyIdentity()
    {
        if (string.IsNullOrEmpty(_qrText)) return;
        try
        {
            await Clipboard.SetTextAsync(_qrText);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch { }
    }

    async Task ShareIdentity()
    {
        var identity = Seed.Identity?.ToString();
        if (identity == null) return;
        try
        {
            await Share.RequestAsync(new ShareTextRequest
            {
                Text = string.IsNullOrEmpty(_qrText) ? identity : _qrText,
                Title = "Qubic Identity"
            });
        }
        catch { }
    }
}
