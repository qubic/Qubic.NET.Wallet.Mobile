@page "/more"
@inject Qubic.Services.Features.FeatureService Features

<h4>More</h4>

<ul class="qb-link-list">
    <li>
        <a href="/vault">
            <i class="bi bi-shield-lock-fill"></i>
            Vault
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/watchlist">
            <i class="bi bi-eye"></i>
            Watchlist
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/history">
            <i class="bi bi-clock-history"></i>
            History
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/sync">
            <i class="bi bi-arrow-repeat"></i>
            Sync Manager
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/receive">
            <i class="bi bi-qr-code"></i>
            Receive / QR Code
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/signverify">
            <i class="bi bi-pen"></i>
            Sign / Verify Message
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/voting">
            <i class="bi bi-check2-square"></i>
            Governance / Voting
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/scauctions">
            <i class="bi bi-hammer"></i>
            SC Auctions
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/networks">
            <i class="bi bi-hdd-network"></i>
            Networks
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    @if (Features.IsEnabled(Qubic.Services.Features.WalletFeature.WalletConnect))
    {
        <li>
            <a href="/walletconnect">
                <i class="bi bi-link-45deg"></i>
                WalletConnect
                <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
            </a>
        </li>
    }
    @if (Features.IsEnabled(Qubic.Services.Features.WalletFeature.DeveloperTools))
    {
        <li>
            <a href="/devtools">
                <i class="bi bi-tools"></i>
                Dev Tools
                <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
            </a>
        </li>
        <li>
            <a href="/contracts">
                <i class="bi bi-braces"></i>
                Contract Console
                <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
            </a>
        </li>
    }
    <li>
        <a href="/features">
            <i class="bi bi-toggles"></i>
            Features
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
    <li>
        <a href="/settings">
            <i class="bi bi-gear-fill"></i>
            Settings
            <span class="qb-link-chevron"><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>
</ul>
